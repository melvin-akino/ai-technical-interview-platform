# Global options — the ACME account email receives certificate expiry/problem notices.
{
    email akino.melvin@gmail.com
}

# Caddy automatically obtains and renews a real Let's Encrypt certificate for both names,
# and redirects HTTP -> HTTPS. Requires DNS A records pointing here and ports 80 (ACME
# HTTP-01 challenge + redirect) and 443 open in the security group.
#
# Do NOT add a catch-all ":443" block with an explicit `tls <cert> <key>`: its connection
# policy has no host matcher, so it wins for every SNI on that port and would serve that
# certificate instead of the managed one — silently breaking TLS for these domains.
# For the same reason, never list these hostnames as SANs on a manually supplied cert:
# Caddy then logs "skipping automatic certificate management ... already loaded" and never
# contacts Let's Encrypt at all.
aurainterview.online, www.aurainterview.online {
    reverse_proxy frontend:80
}
